<ul class="cv-entry-list">
  {% for entry in entries %}
    <li class="cv-entry">
      <div class="cv-entry-date-col">
        {% capture release_date %}
          {% if entry.releaseDate %}{{ entry.releaseDate }}{% elsif entry.date %}{{ entry.date }}{% endif %}
        {% endcapture %}

        {% if release_date != '' %}
          {% assign date = release_date | split: '-' | first %}
        {% else %}
          {% assign date = null %}
        {% endif %}

        {% if date %}
          <div class="cv-date">{{ date }}</div>
        {% endif %}
      </div>

      <div class="cv-entry-content">
        {% capture name %}
          {% if entry.name %}{{ entry.name }}{% elsif entry.title %}{{ entry.title }}{% endif %}
        {% endcapture %}

        {% if entry.url %}
          <h6 class="title font-weight-bold">
            <a href="{{ entry.url }}">{{ name }}</a>
          </h6>
        {% elsif name != '' %}
          <h6 class="title font-weight-bold">{{ name }}</h6>
        {% endif %}

        {% if entry.publisher %}
          <h6 style="font-size: 0.95rem">{{ entry.publisher }}</h6>
        {% endif %}

        {% if entry.summary or entry.abstract %}
          <h6 style="font-size: 0.95rem; font-style: italic">
            {% if entry.summary %}{{ entry.summary }}{% else %}{{ entry.abstract }}{% endif %}
          </h6>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
